generator client {
	provider = "prisma-client-js"
}

datasource db {
	provider  = "postgresql"
	url       = env("DATABASE_POOLED_URL")
	directUrl = env("DATABASE_URL")
}

enum RecordStatus {
	ACTIVE
	INACTIVE
}

enum ArchiveStatus {
	ACTIVE
	ARCHIVED
}

enum Gender {
	BOY
	GIRL
}

enum EnrollmentStatus {
	ACTIVE
	WITHDRAWN
	COMPLETED
}

enum PayMethod {
	KEELA
	ZELLE
	CASH
	CASHAPP
	SQUARE
	CHECK
	FREE
	OTHER
	NA
	CARD
}

enum PaymentStatus {
	PAID
	PARTIAL
	UNPAID
	NA
}

enum RegistrationStatus {
	PENDING
	APPROVED
	REJECTED
}

enum MilestoneType {
	JUZ
	BOOK
}

enum PayPeriodStatus {
	OPEN
	LOCKED
	PAID
}

model Programs {
	id          String        @id @default(uuid())

	name        String        @unique
	description String?
	status      ArchiveStatus @default(ACTIVE)

	slug             String?   @unique
	registrationOpen Boolean   @default(false) @map("registration_open")
	registrationFee  Decimal   @default(0) @map("registration_fee") @db.Decimal(10, 2)
	monthlyFees      Decimal[] @default([]) @map("monthly_fees") @db.Decimal(10, 2)
	classTimes       String[]  @default([]) @map("class_times")
	publicInfo       String?   @map("public_info")

	classes     Classes[]
	registrations Registrations[]
	families    FamilyPrograms[]
	students    StudentPrograms[]
	teachers    TeacherPrograms[]
	timeEntries TimeEntries[]

	invoices    MonthlyInvoices[]

	createdAt   DateTime      @default(now()) @map("created_at")
	updatedAt   DateTime      @updatedAt @map("updated_at")

	@@map("programs")
}

model Families {
	id String @id @default(uuid())

	name           String
	fatherName     String?      @map("father_name")
	motherName     String?      @map("mother_name")
	primaryPhone   String       @map("primary_phone")
	secondaryPhone String?      @map("secondary_phone")
	email          String?
	address        String?
	status         RecordStatus @default(ACTIVE)
	notes          String?

	students Students[]
	invoices MonthlyInvoices[]
	programs FamilyPrograms[]
	registrations Registrations[]

	createdAt DateTime @default(now()) @map("created_at")
	updatedAt DateTime @updatedAt @map("updated_at")

	@@index([name])
	@@map("families")
}

model FamilyPrograms {
	familyId String   @map("family_id")
	family   Families @relation(fields: [familyId], references: [id], onDelete: Cascade)

	programId String   @map("program_id")
	program   Programs @relation(fields: [programId], references: [id], onDelete: Cascade)

	studentCount Int     @default(0) @map("student_count")
	monthlyFee   Decimal @default(0) @map("monthly_fee") @db.Decimal(10, 2)

	createdAt DateTime @default(now()) @map("created_at")

	@@id([familyId, programId])
	@@index([programId])
	@@map("family_programs")
}

model StudentPrograms {
	studentId String   @map("student_id")
	student   Students @relation(fields: [studentId], references: [id], onDelete: Cascade)

	programId String   @map("program_id")
	program   Programs @relation(fields: [programId], references: [id], onDelete: Cascade)

	createdAt DateTime @default(now()) @map("created_at")

	@@id([studentId, programId])
	@@index([programId])
	@@map("student_programs")
}

model Milestones {
	id String @id @default(uuid())

	type        MilestoneType
	juzNumber   Int?          @map("juz_number")
	bookName    String?       @map("book_name")
	completedAt DateTime      @map("completed_at") @db.Date
	notes       String?

	studentId String   @map("student_id")
	student   Students @relation(fields: [studentId], references: [id], onDelete: Cascade)

	createdAt DateTime @default(now()) @map("created_at")
	updatedAt DateTime @updatedAt @map("updated_at")

	@@unique([studentId, juzNumber])
	@@index([completedAt])
	@@map("milestones")
}

model Registrations {
	id String @id @default(uuid())

	status RegistrationStatus @default(PENDING)

	parentFirstName String  @map("parent_first_name")
	parentLastName  String  @map("parent_last_name")
	email           String
	phone           String
	emergencyPhone  String? @map("emergency_phone")
	address         String?
	preferredTime   String? @map("preferred_time")
	notes           String?

	// [{ firstName, lastName, gender, dateOfBirth, notes }]
	students     Json
	studentCount Int  @map("student_count")

	monthlyFee      Decimal @map("monthly_fee") @db.Decimal(10, 2)
	registrationFee Decimal @map("registration_fee") @db.Decimal(10, 2)
	amountDue       Decimal @map("amount_due") @db.Decimal(10, 2)

	payByCard            Boolean       @default(false) @map("pay_by_card")
	paymentStatus        PaymentStatus @default(UNPAID) @map("payment_status")
	paidAt               DateTime?     @map("paid_at")
	stripeSessionId      String?       @unique @map("stripe_session_id")
	stripeCustomerId     String?       @map("stripe_customer_id")
	stripeSubscriptionId String?       @map("stripe_subscription_id")

	programId String   @map("program_id")
	program   Programs @relation(fields: [programId], references: [id])

	familyId String?   @map("family_id")
	family   Families? @relation(fields: [familyId], references: [id], onDelete: SetNull)

	reviewedAt DateTime? @map("reviewed_at")

	createdAt DateTime @default(now()) @map("created_at")
	updatedAt DateTime @updatedAt @map("updated_at")

	@@index([status])
	@@map("registrations")
}

model Students {
	id String @id @default(uuid())

	firstName   String       @map("first_name")
	lastName    String       @map("last_name")
	gender      Gender
	dateOfBirth DateTime?    @map("date_of_birth")
	status      RecordStatus @default(ACTIVE)
	enrolledAt  DateTime?    @map("enrolled_at")
	notes       String?

	familyId String   @map("family_id")
	family   Families @relation(fields: [familyId], references: [id], onDelete: Cascade)

	enrollments Enrollments[]
	programs    StudentPrograms[]
	milestones  Milestones[]

	createdAt DateTime @default(now()) @map("created_at")
	updatedAt DateTime @updatedAt @map("updated_at")

	@@index([familyId])
	@@map("students")
}

model TeacherPrograms {
	teacherId String   @map("teacher_id")
	teacher   Teachers @relation(fields: [teacherId], references: [id], onDelete: Cascade)

	programId String   @map("program_id")
	program   Programs @relation(fields: [programId], references: [id], onDelete: Cascade)

	createdAt DateTime @default(now()) @map("created_at")

	@@id([teacherId, programId])
	@@index([programId])
	@@map("teacher_programs")
}

model Teachers {
	id String @id @default(uuid())

	firstName      String       @map("first_name")
	lastName       String       @map("last_name")
	phoneNumber    String?      @map("phone_number")
	email          String?
	hourlyRate     Decimal?     @map("hourly_rate") @db.Decimal(10, 2)
	supabaseUserId String?      @unique @map("supabase_user_id")
	status         RecordStatus @default(ACTIVE)

	classes     Classes[]
	programs    TeacherPrograms[]
	timeEntries TimeEntries[]
	payRecords  PayRecords[]
	submissions TeacherSubmissions[]

	createdAt DateTime @default(now()) @map("created_at")
	updatedAt DateTime @updatedAt @map("updated_at")

	@@map("teachers")
}

model Classes {
	id String @id @default(uuid())

	name   String
	status ArchiveStatus @default(ACTIVE)

	programId String   @map("program_id")
	program   Programs @relation(fields: [programId], references: [id])

	teacherId String?   @map("teacher_id")
	teacher   Teachers? @relation(fields: [teacherId], references: [id])

	enrollments Enrollments[]
	timeEntries TimeEntries[]

	createdAt DateTime @default(now()) @map("created_at")
	updatedAt DateTime @updatedAt @map("updated_at")

	@@unique([name, programId])
	@@map("classes")
}

model Enrollments {
	id String @id @default(uuid())

	status    EnrollmentStatus @default(ACTIVE)
	startDate DateTime         @default(now()) @map("start_date")
	endDate   DateTime?        @map("end_date")

	studentId String   @map("student_id")
	student   Students @relation(fields: [studentId], references: [id], onDelete: Cascade)

	classId String  @map("class_id")
	class   Classes @relation(fields: [classId], references: [id], onDelete: Cascade)

	createdAt DateTime @default(now()) @map("created_at")
	updatedAt DateTime @updatedAt @map("updated_at")

	@@unique([studentId, classId])
	@@index([classId])
	@@map("enrollments")
}

model MonthlyInvoices {
	id String @id @default(uuid())

	year                Int
	month               Int
	studentCount        Int           @default(0) @map("student_count")
	registrationFee     Decimal       @default(0) @map("registration_fee") @db.Decimal(10, 2)
	tuitionFee          Decimal       @default(0) @map("tuition_fee") @db.Decimal(10, 2)
	bookFee             Decimal       @default(0) @map("book_fee") @db.Decimal(10, 2)
	totalDue            Decimal       @default(0) @map("total_due") @db.Decimal(10, 2)
	paidRegistrationFee Decimal       @default(0) @map("paid_registration_fee") @db.Decimal(10, 2)
	paidTuitionFee      Decimal       @default(0) @map("paid_tuition_fee") @db.Decimal(10, 2)
	paidBookFee         Decimal       @default(0) @map("paid_book_fee") @db.Decimal(10, 2)
	extraPaid           Decimal       @default(0) @map("extra_paid") @db.Decimal(10, 2)
	totalPaid           Decimal       @default(0) @map("total_paid") @db.Decimal(10, 2)
	balance             Decimal       @default(0) @db.Decimal(10, 2)
	payMethod           PayMethod     @default(NA) @map("pay_method")
	paymentStatus       PaymentStatus @default(UNPAID) @map("payment_status")
	paidAt              DateTime?     @map("paid_at")
	notes               String?

	familyId String   @map("family_id")
	family   Families @relation(fields: [familyId], references: [id], onDelete: Cascade)

	programId String   @map("program_id")
	program   Programs @relation(fields: [programId], references: [id])

	createdAt DateTime @default(now()) @map("created_at")
	updatedAt DateTime @updatedAt @map("updated_at")

	@@unique([familyId, programId, year, month])
	@@index([year, month])
	@@map("monthly_invoices")
}

model PayPeriods {
	id String @id @default(uuid())

	name      String
	startDate DateTime        @map("start_date")
	endDate   DateTime        @map("end_date")
	status    PayPeriodStatus @default(OPEN)

	timeEntries TimeEntries[]
	payRecords  PayRecords[]
	submissions TeacherSubmissions[]

	createdAt DateTime @default(now()) @map("created_at")
	updatedAt DateTime @updatedAt @map("updated_at")

	@@map("pay_periods")
}

model TimeEntries {
	id String @id @default(uuid())

	date  DateTime
	hours Decimal  @db.Decimal(5, 2)
	notes String?

	teacherId String   @map("teacher_id")
	teacher   Teachers @relation(fields: [teacherId], references: [id], onDelete: Cascade)

	classId String?  @map("class_id")
	class   Classes? @relation(fields: [classId], references: [id], onDelete: Cascade)

	programId String   @map("program_id")
	program   Programs @relation(fields: [programId], references: [id], onDelete: Cascade)

	payPeriodId String     @map("pay_period_id")
	payPeriod   PayPeriods @relation(fields: [payPeriodId], references: [id], onDelete: Cascade)

	createdAt DateTime @default(now()) @map("created_at")
	updatedAt DateTime @updatedAt @map("updated_at")

	@@index([teacherId, payPeriodId])
	@@index([payPeriodId])
	@@index([programId])
	@@map("time_entries")
}

model TeacherSubmissions {
	id String @id @default(uuid())

	submittedAt DateTime @default(now()) @map("submitted_at")

	teacherId String   @map("teacher_id")
	teacher   Teachers @relation(fields: [teacherId], references: [id], onDelete: Cascade)

	payPeriodId String     @map("pay_period_id")
	payPeriod   PayPeriods @relation(fields: [payPeriodId], references: [id], onDelete: Cascade)

	createdAt DateTime @default(now()) @map("created_at")
	updatedAt DateTime @updatedAt @map("updated_at")

	@@unique([teacherId, payPeriodId])
	@@map("teacher_submissions")
}

model PayRecords {
	id String @id @default(uuid())

	totalHours Decimal @map("total_hours") @db.Decimal(10, 2)
	hourlyRate Decimal @map("hourly_rate") @db.Decimal(10, 2)
	totalPay   Decimal @map("total_pay") @db.Decimal(10, 2)

	teacherId String   @map("teacher_id")
	teacher   Teachers @relation(fields: [teacherId], references: [id], onDelete: Cascade)

	payPeriodId String     @map("pay_period_id")
	payPeriod   PayPeriods @relation(fields: [payPeriodId], references: [id], onDelete: Cascade)

	createdAt DateTime @default(now()) @map("created_at")
	updatedAt DateTime @updatedAt @map("updated_at")

	@@unique([teacherId, payPeriodId])
	@@map("pay_records")
}
