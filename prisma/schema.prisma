generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_POOLED_URL")
  directUrl = env("DATABASE_URL")
}

enum ProgramCode {
  HIFZ
  WEEKEND
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum ArchiveStatus {
  ACTIVE
  ARCHIVED
}

enum Gender {
  BOY
  GIRL
}

enum ClassSession {
  AM
  PM
  AM_PM
  NA
}

enum EnrollmentStatus {
  ACTIVE
  WITHDRAWN
  COMPLETED
}

enum PayMethod {
  KEELA
  ZELLE
  CASH
  CASHAPP
  CHECK
  FREE
  OTHER
  NA
}

enum PaymentStatus {
  PAID
  PARTIAL
  UNPAID
  NA
}

enum PayrollStatus {
  DRAFT
  PAID
}

model Programs {
  id String @id @default(uuid())

  code        ProgramCode   @unique
  name        String        @unique
  description String?
  status      ArchiveStatus @default(ACTIVE)

  classes     Classes[]
  enrollments Enrollments[]
  invoices    MonthlyInvoices[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("programs")
}

model Families {
  id String @id @default(uuid())

  name           String
  fatherName     String?      @map("father_name")
  motherName     String?      @map("mother_name")
  primaryPhone   String       @map("primary_phone")
  secondaryPhone String?      @map("secondary_phone")
  email          String?
  address        String?
  status         RecordStatus @default(ACTIVE)
  notes          String?

  students Students[]
  invoices MonthlyInvoices[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@map("families")
}

model Students {
  id String @id @default(uuid())

  firstName   String       @map("first_name")
  lastName    String       @map("last_name")
  gender      Gender
  dateOfBirth DateTime?    @map("date_of_birth")
  status      RecordStatus @default(ACTIVE)
  enrolledAt  DateTime?    @map("enrolled_at")
  notes       String?

  familyId String   @map("family_id")
  family   Families @relation(fields: [familyId], references: [id], onDelete: Cascade)

  enrollments Enrollments[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([familyId])
  @@map("students")
}

model Teachers {
  id String @id @default(uuid())

  firstName   String       @map("first_name")
  lastName    String       @map("last_name")
  phoneNumber String?      @map("phone_number")
  email       String?
  zelleId     String?      @map("zelle_id")
  hourlyRate  Decimal      @default(0) @map("hourly_rate") @db.Decimal(10, 2)
  status      RecordStatus @default(ACTIVE)

  classes        Classes[]
  payrollEntries PayrollEntries[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("teachers")
}

model Classes {
  id String @id @default(uuid())

  name       String
  session    ClassSession  @default(NA)
  room       String?
  schoolYear Int           @map("school_year")
  capacity   Int?
  status     ArchiveStatus @default(ACTIVE)

  programId String   @map("program_id")
  program   Programs @relation(fields: [programId], references: [id])

  teacherId String?   @map("teacher_id")
  teacher   Teachers? @relation(fields: [teacherId], references: [id])

  enrollments Enrollments[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([name, programId, schoolYear])
  @@map("classes")
}

model Enrollments {
  id String @id @default(uuid())

  status    EnrollmentStatus @default(ACTIVE)
  startDate DateTime         @default(now()) @map("start_date")
  endDate   DateTime?        @map("end_date")

  studentId String   @map("student_id")
  student   Students @relation(fields: [studentId], references: [id], onDelete: Cascade)

  classId String  @map("class_id")
  class   Classes @relation(fields: [classId], references: [id], onDelete: Cascade)

  programId String   @map("program_id")
  program   Programs @relation(fields: [programId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([studentId, classId])
  @@index([classId])
  @@map("enrollments")
}

model MonthlyInvoices {
  id String @id @default(uuid())

  year                Int
  month               Int
  studentCount        Int           @default(0) @map("student_count")
  session             ClassSession?
  registrationFee     Decimal       @default(0) @map("registration_fee") @db.Decimal(10, 2)
  tuitionFee          Decimal       @default(0) @map("tuition_fee") @db.Decimal(10, 2)
  bookFee             Decimal       @default(0) @map("book_fee") @db.Decimal(10, 2)
  totalDue            Decimal       @default(0) @map("total_due") @db.Decimal(10, 2)
  paidRegistrationFee Decimal       @default(0) @map("paid_registration_fee") @db.Decimal(10, 2)
  paidTuitionFee      Decimal       @default(0) @map("paid_tuition_fee") @db.Decimal(10, 2)
  paidBookFee         Decimal       @default(0) @map("paid_book_fee") @db.Decimal(10, 2)
  extraPaid           Decimal       @default(0) @map("extra_paid") @db.Decimal(10, 2)
  totalPaid           Decimal       @default(0) @map("total_paid") @db.Decimal(10, 2)
  balance             Decimal       @default(0) @db.Decimal(10, 2)
  payMethod           PayMethod     @default(NA) @map("pay_method")
  paymentStatus       PaymentStatus @default(UNPAID) @map("payment_status")
  paidAt              DateTime?     @map("paid_at")
  notes               String?

  familyId String   @map("family_id")
  family   Families @relation(fields: [familyId], references: [id], onDelete: Cascade)

  programId String   @map("program_id")
  program   Programs @relation(fields: [programId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([familyId, programId, year, month])
  @@index([year, month, programId])
  @@map("monthly_invoices")
}

model PayrollPeriods {
  id String @id @default(uuid())

  label     String
  year      Int
  month     Int
  startDate DateTime      @map("start_date")
  endDate   DateTime      @map("end_date")
  status    PayrollStatus @default(DRAFT)
  notes     String?

  entries PayrollEntries[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([year, month])
  @@map("payroll_periods")
}

model PayrollEntries {
  id String @id @default(uuid())

  hourlyRate   Decimal       @default(0) @map("hourly_rate") @db.Decimal(10, 2)
  weekdayHours Decimal       @default(0) @map("weekday_hours") @db.Decimal(10, 2)
  weekendHours Decimal       @default(0) @map("weekend_hours") @db.Decimal(10, 2)
  weekdayPay   Decimal       @default(0) @map("weekday_pay") @db.Decimal(10, 2)
  weekendPay   Decimal       @default(0) @map("weekend_pay") @db.Decimal(10, 2)
  totalPay     Decimal       @default(0) @map("total_pay") @db.Decimal(10, 2)
  payStatus    PayrollStatus @default(DRAFT) @map("pay_status")
  notes        String?

  periodId String         @map("period_id")
  period   PayrollPeriods @relation(fields: [periodId], references: [id], onDelete: Cascade)

  teacherId String   @map("teacher_id")
  teacher   Teachers @relation(fields: [teacherId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([periodId, teacherId])
  @@map("payroll_entries")
}
