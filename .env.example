# App
NEXT_PUBLIC_APP_URL=

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Prisma
# DATABASE_URL = directUrl -> session pooler, port 5432 (KHONG dung 6543)
DATABASE_URL=
# DATABASE_POOLED_URL = runtime queries -> transaction pooler, port 6543
DATABASE_POOLED_URL=

# Vercel deploy script
VERCEL_DEPLOY_GIT_NAME="Owner Name"
VERCEL_DEPLOY_GIT_EMAIL="owner@example.com"
VERCEL_DEPLOY_BRANCH="main"
# VERCEL_DEPLOY_COMMIT_MESSAGE="Deploy message"  # hoặc truyền qua CLI
# VERCEL_DEPLOY_SKIP_CHECKS=1  # bỏ qua lint + build
# VERCEL_DEPLOY_DRY_RUN=1      # test không push
